# Copy this file to .env and fill in your own values.
SECRET_KEY=change-me
DEBUG=True
DB_NAME=mediconnect
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
# Redis broker for Celery (Docker: docker run -p 6379:6379 redis, or Memurai on Windows)
CELERY_BROKER_URL=redis://localhost:6379/0
# True = run Celery tasks directly in the web process (no Redis/worker needed)
CELERY_TASK_ALWAYS_EAGER=True
# Claude patient brief: leave the key empty in Git; configure it only in .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
